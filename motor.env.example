# Copia este archivo a motor.env (no se sube a git) en la carpeta del motor y reinicia el motor.
# Solo hace falta cuando el motor corre en un VPS. En tu PC, sin este archivo, todo sigue igual.
#
# Genera cada clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mínimo 24 caracteres; la de operar y la de lectura deben ser distintas.

# Envía órdenes, cierra posiciones, activa el auto-trading y toca el kill switch
MT5_TOKEN_OPERAR=

# Opcional: solo ve precios, señales y posiciones (para compartir o para el móvil)
MT5_TOKEN_LECTURA=

# Opcional: ruta de MetaTrader 5 si no está en la carpeta por defecto
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
